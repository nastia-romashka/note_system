@refreshToken = f6076076-03bd-449b-8bb4-ae8aa0d29e69
@categoryUuid = 8cbf1003-f305-42b2-bde8-5b8ec0809397
@noteUuid = 000000000000000000000000
@tagUuid = 000000000000000000000000

### API Service: Signup
POST {{baseUrl}}/api/signup
Content-Type: application/json

{
  "username": "new_user",
  "password": "secret",
  "email": "new_user@example.com"
}

### API Service: Auth
POST {{baseUrl}}/api/auth
Content-Type: application/json

{
  "username": "me",
  "password": "pass"
}

### API Service: Heartbeat
GET {{baseUrl}}/api/heartbeat
Authorization: Bearer {{accessToken}}
Accept: application/json

### API Service: Refresh access token
PUT {{baseUrl}}/api/auth
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### Integration: Get categories via api_service -> category_service
GET {{baseUrl}}/api/categories
Authorization: Bearer {{accessToken}}
Accept: application/json

### Integration: Create root category
POST {{baseUrl}}/api/categories
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Work"
}

### Integration: Create sub category
POST {{baseUrl}}/api/categories
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Work child",
  "parent_uuid": "{{categoryUuid}}"
}

### Integration: Update category
PATCH {{baseUrl}}/api/categories/{{categoryUuid}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated Work"
}

### Integration: Delete category
DELETE {{baseUrl}}/api/categories/{{categoryUuid}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Integration: Get notes by category
GET {{baseUrl}}/api/notes?category_uuid={{categoryUuid}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Integration: Create note
POST {{baseUrl}}/api/notes
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "header": "First note",
  "body": "This is a sample note body.",
  "category_uuid": "{{categoryUuid}}",
  "tags": []
}

### Integration: Get one note
GET {{baseUrl}}/api/notes/{{noteUuid}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Integration: Update note
PATCH {{baseUrl}}/api/notes/{{noteUuid}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "header": "Updated note title"
}

### Integration: Delete note
DELETE {{baseUrl}}/api/notes/{{noteUuid}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Integration: Get tags
GET {{baseUrl}}/api/tags
Authorization: Bearer {{accessToken}}
Accept: application/json

### Integration: Get tag by ids
GET {{baseUrl}}/api/tags?id={{tagUuid}}
Authorization: Bearer {{accessToken}}
Accept: application/json

### Integration: Create tag
POST {{baseUrl}}/api/tags
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "work"
}

### Integration: Delete tag
DELETE {{baseUrl}}/api/tags/{{tagUuid}}
Authorization: Bearer {{accessToken}}
Accept: application/json
